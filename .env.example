# Application
APP_NAME=multi-agent-system
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# LLM provider (OpenRouter defaults)
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=multi-agent-system

# Alternative providers
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=

# Optional
ANTHROPIC_API_KEY=

# PostgreSQL
POSTGRES_USER=multi_agent
POSTGRES_PASSWORD=multi_agent
POSTGRES_DB=multi_agent
POSTGRES_URL=postgresql+asyncpg://multi_agent:multi_agent@postgres:5432/multi_agent

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333

# Vector DB
QDRANT_COLLECTION_NAME=multi_agent_memory
RAG_COLLECTION_NAME=multi_agent_rag
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Monitoring
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-system
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

STRUCTURED_LOGGING=true
METRICS_ENABLED=true

OTEL_ENABLED=false

# Security
SECRET_KEY=change_this_to_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Memory
MEMORY_TTL=86400
MAX_CONVERSATION_HISTORY=100

# Execution
MAX_PARALLEL_TASKS=10
TASK_TIMEOUT_SECONDS=300
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5

# Human Approval
REQUIRE_HUMAN_APPROVAL=false
APPROVAL_TIMEOUT_SECONDS=300

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
